-		wrmsrl_safe(MSR_IA32_SGXLEPUBKEYHASH2, 0xc4916d99f2b3735dULL) ||
-		wrmsrl_safe(MSR_IA32_SGXLEPUBKEYHASH3, 0xd4f8c05909f9bb3bULL))
+	if (SGX_RESET_PUBKEY_HASH(MSR_IA32_SGXLEPUBKEYHASH0, 0xa6053e051270b7acULL) ||
+	    SGX_RESET_PUBKEY_HASH(MSR_IA32_SGXLEPUBKEYHASH1, 0x6cfbe8ba8b3b413dULL) ||
+	    SGX_RESET_PUBKEY_HASH(MSR_IA32_SGXLEPUBKEYHASH2, 0xc4916d99f2b3735dULL) ||
