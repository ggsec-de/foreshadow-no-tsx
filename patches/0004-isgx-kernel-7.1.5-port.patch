+/*
+ * Restore Intel's Launch Enclave public key hash. Without flexible launch
+ * control these MSRs are read-only and already hold that value (the firmware
+ * programmed it), so the write fails harmlessly -- which is exactly why the
+ * safe variant is used.
+ */
+#define SGX_RESET_PUBKEY_HASH(msr, value)					\
+	wrmsr_safe(msr, (u32)(value), (u32)((u64)(value) >> 32))
+
